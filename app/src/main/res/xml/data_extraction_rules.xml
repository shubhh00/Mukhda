<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup for Android 12+: keep Room and DataStore (anon UID, prefs). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
